# bitrl CMake package. Use it with
#
#     find_package(bitrl 5 REQUIRED)
#     target_link_libraries(my_target PRIVATE bitrl::bitrl)
#
# and -DCMAKE_PREFIX_PATH="<bitrl prefix>;<bitsim prefix>;<libtorch dir>" for
# the ones that are not in a system prefix. bitrl links to bitsim, libtorch
# and TBB, so those are found too.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(bitsim @bitsim_VERSION_MAJOR@)
find_dependency(Torch CONFIG)
find_dependency(TBB)

include("${CMAKE_CURRENT_LIST_DIR}/bitrlTargets.cmake")
check_required_components(bitrl)
